# Copy to .env and fill in. .env is gitignored — keep it that way.
# All credentials here are READ-ONLY. This repo has no order-placement path.

# --- Required for the betting pipeline --------------------------------------

# the-odds-api.com. The stake job uses ~2 requests per week.
ODDS_API_KEY=

# Kalshi API key ID (a UUID, from Kalshi's API keys page).
KALSHI_API_KEY_ID=

# Path to the RSA private key file Kalshi made you download when you created
# the key. Local runs only.
#
# In GitHub Actions, set KALSHI_PRIVATE_KEY_PEM to the file's full CONTENTS
# instead — including the -----BEGIN/END----- lines — so the key is never
# written to the runner's filesystem. The PEM env var wins when both are set,
# so a stale path here cannot override a CI secret.
KALSHI_PRIVATE_KEY_PATH=

# --- Legacy CLI only --------------------------------------------------------
# Used by `python main.py ask` for the scout-vs-quant debates. Not on the
# betting path; leave blank unless you want that command.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
